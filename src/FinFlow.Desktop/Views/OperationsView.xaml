<UserControl x:Class="FinFlow.Desktop.Views.OperationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
            <StackPanel>
                <TextBlock Text="НОВАЯ ОПЕРАЦИЯ" Style="{StaticResource SectionCaption}" />
                <TextBlock Text="Счёт" Style="{StaticResource SectionCaption}" Margin="0,6,0,4" />
                <StackPanel Orientation="Horizontal">
                    <TextBox Width="220" Text="{Binding AccountNumber, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Загрузить" Command="{Binding LoadCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding AccountCaption}" FontSize="11" Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" Margin="0,8,0,12" />

                <TextBlock Text="Вид операции" Style="{StaticResource SectionCaption}" />
                <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}"
                          DisplayMemberPath="Name" Margin="0,0,0,10" />

                <TextBlock Text="Сумма, р." Style="{StaticResource SectionCaption}" />
                <TextBox Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                <TextBlock Text="Номер документа" Style="{StaticResource SectionCaption}" />
                <TextBox Text="{Binding DocumentNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                <TextBlock Text="Назначение" Style="{StaticResource SectionCaption}" />
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" Height="60"
                         TextWrapping="Wrap" AcceptsReturn="True" Margin="0,0,0,12" />

                <Button Content="Создать черновик" Command="{Binding CreateCommand}" HorizontalAlignment="Left" />
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12"
                           Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="12,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="ОПЕРАЦИИ ПО СЧЁТУ" Style="{StaticResource SectionCaption}" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Обновить" Command="{Binding RefreshOperationCommand}" Style="{StaticResource SecondaryButton}" />
                        <Button Content="Отправить на проверку" Command="{Binding SubmitCommand}" />
                        <Button Content="Сторнировать" Command="{Binding ReverseCommand}" Style="{StaticResource DangerButton}" />
                        <TextBlock Text="Причина" Margin="8,0,6,0" />
                        <TextBox Width="220" Text="{Binding ReasonText, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <TextBlock Text="{Binding SelectedOperationCaption}" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,0,0,8" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="130" />
                        <DataGridTextColumn Header="Вид" Binding="{Binding KindText}" Width="*" />
                        <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="110" />
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="130" />
                        <DataGridTextColumn Header="Автор" Binding="{Binding CreatedByLogin}" Width="110" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
