<Window x:Class="FinFlow.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:FinFlow.Desktop.Views"
        Title="FinFlow — операционный контур" Height="860" Width="1320"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="#0F172A" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="FinFlow" FontSize="20" FontWeight="Bold" Foreground="White" />
                    <TextBlock Text="операционный контур" FontSize="12" Foreground="#94A3B8" Margin="10,0,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="{Binding UserCaption}" Foreground="#E2E8F0" FontSize="12" Margin="0,0,14,0" />
                    <Button Content="Выйти" Click="OnLogoutClick" Style="{StaticResource SecondaryButton}" Padding="10,5" />
                </StackPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="#E2E8F0" Height="26">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage}" FontSize="11" Foreground="{StaticResource MutedBrush}" />
            </StatusBarItem>
        </StatusBar>

        <TabControl SelectedIndex="{Binding SelectedTabIndex}" SelectionChanged="OnTabChanged" Margin="12">
            <TabItem Header="Клиенты">
                <views:ClientsView DataContext="{Binding Clients}" />
            </TabItem>
            <TabItem Header="Счёт и договор">
                <views:AccountView DataContext="{Binding Account}" />
            </TabItem>
            <TabItem Header="Операции">
                <views:OperationsView DataContext="{Binding Operations}" />
            </TabItem>
            <TabItem Header="Очередь контроля" Visibility="{Binding CanControl, Converter={StaticResource BoolToVisibility}}">
                <views:ControlQueueView DataContext="{Binding ControlQueue}" />
            </TabItem>
            <TabItem Header="Закрытие дня" Visibility="{Binding CanCloseDay, Converter={StaticResource BoolToVisibility}}">
                <views:DayCloseView DataContext="{Binding DayClose}" />
            </TabItem>
            <TabItem Header="Администрирование" Visibility="{Binding CanAdminister, Converter={StaticResource BoolToVisibility}}">
                <views:AdminView DataContext="{Binding Admin}" />
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
