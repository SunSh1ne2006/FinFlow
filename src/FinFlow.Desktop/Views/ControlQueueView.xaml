<UserControl x:Class="FinFlow.Desktop.Views.ControlQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorder}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="ОЧЕРЕДЬ КОНТРОЛЯ" Style="{StaticResource SectionCaption}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource MutedBrush}"
                               Text="Операции в состоянии «На контроле». Автор операции не может подтвердить её сам (бизнес-правило 12): подтверждение выполняется другим сотрудником." />
                    <Button Content="Обновить очередь" Command="{Binding LoadCommand}" HorizontalAlignment="Left" Margin="0,10,0,10" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Queue}" SelectedItem="{Binding SelectedOperation}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding CreatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" Width="140" />
                        <DataGridTextColumn Header="Счёт" Binding="{Binding AccountNumber}" Width="170" />
                        <DataGridTextColumn Header="Клиент" Binding="{Binding ClientName}" Width="*" />
                        <DataGridTextColumn Header="Вид" Binding="{Binding KindText}" Width="160" />
                        <DataGridTextColumn Header="Сумма" Binding="{Binding Amount, StringFormat={}{0:N2}}" Width="110" />
                        <DataGridTextColumn Header="Автор" Binding="{Binding CreatedByLogin}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="12,0,0,12">
            <StackPanel>
                <TextBlock Text="РЕШЕНИЕ ПО ОПЕРАЦИИ" Style="{StaticResource SectionCaption}" />
                <TextBlock Text="{Binding SelectedOperationCaption}" TextWrapping="Wrap" FontWeight="SemiBold" />
                <TextBlock Text="{Binding CheckedCaption}" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,12" />

                <TextBlock Text="Подпись (ЭП)" Style="{StaticResource SectionCaption}" />
                <TextBox Text="{Binding SignatureText, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                <TextBlock Text="Причина отклонения" Style="{StaticResource SectionCaption}" />
                <TextBox Text="{Binding ReasonText, UpdateSourceTrigger=PropertyChanged}" Height="56" TextWrapping="Wrap"
                         AcceptsReturn="True" Margin="0,0,0,12" />

                <StackPanel Orientation="Horizontal">
                    <Button Content="Подтвердить" Command="{Binding ApproveCommand}" />
                    <Button Content="Отклонить" Command="{Binding RejectCommand}" Style="{StaticResource DangerButton}" />
                </StackPanel>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12"
                           TextWrapping="Wrap" Margin="0,10,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
