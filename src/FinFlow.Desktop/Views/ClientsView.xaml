<UserControl x:Class="FinFlow.Desktop.Views.ClientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0">
            <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="Клиенты банка" FontSize="18" FontWeight="Bold" />
                    <TextBlock Text="Поиск по наименованию, УНП или номеру документа"
                               Style="{StaticResource SectionCaption}" Margin="0,4,0,8" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox Width="280" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <Button Content="Найти" Command="{Binding SearchCommand}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="◀" Command="{Binding PrevPageCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" />
                        <Button Content="▶" Command="{Binding NextPageCommand}" Style="{StaticResource SecondaryButton}" Padding="10,4" />
                        <TextBlock Text="{Binding PageCaption}" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border DockPanel.Dock="Bottom" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Text="РЕГИСТРАЦИЯ КЛИЕНТА" Style="{StaticResource SectionCaption}" />
                    <TextBlock Text="Тип клиента" Style="{StaticResource SectionCaption}" />
                    <ComboBox ItemsSource="{Binding ClientTypes}" SelectedItem="{Binding NewType}" Margin="0,0,0,6" />
                    <TextBlock Text="ФИО / наименование" Style="{StaticResource SectionCaption}" />
                    <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                    <TextBlock Text="УНП или номер документа" Style="{StaticResource SectionCaption}" />
                    <TextBox Text="{Binding NewIdNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" />
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <StackPanel Width="150">
                            <TextBlock Text="Дата рождения" Style="{StaticResource SectionCaption}" />
                            <DatePicker SelectedDate="{Binding NewBirthDate}" />
                        </StackPanel>
                        <StackPanel Width="130" Margin="8,0,0,0">
                            <TextBlock Text="Телефон" Style="{StaticResource SectionCaption}" />
                            <TextBox Text="{Binding NewPhone, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Width="120" Margin="8,0,0,0">
                            <TextBlock Text="E-mail" Style="{StaticResource SectionCaption}" />
                            <TextBox Text="{Binding NewEmail, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </StackPanel>
                    <Button Content="Зарегистрировать клиента" Command="{Binding CreateClientCommand}" HorizontalAlignment="Left" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource DangerBrush}" FontSize="12"
                               Margin="0,6,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <DataGrid ItemsSource="{Binding Clients}" SelectedItem="{Binding SelectedClient}" Margin="0,10,0,10"
                      AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal" CanUserAddRows="False">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Клиент" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Тип" Binding="{Binding TypeText}" Width="110" />
                    <DataGridTextColumn Header="Счетов" Binding="{Binding AccountsCount}" Width="60" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{Binding ClientCaption}" FontSize="18" FontWeight="Bold" />
                        <TextBlock Text="{Binding ClientInfo}" Foreground="{StaticResource MutedBrush}" FontSize="12"
                                   Margin="0,4,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="СЧЕТА И ВКЛАДЫ КЛИЕНТА" Style="{StaticResource SectionCaption}" />
                        <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}"
                                  AutoGenerateColumns="False" IsReadOnly="True" Height="170" HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal" CanUserAddRows="False">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Номер" Binding="{Binding Number}" Width="*" />
                                <DataGridTextColumn Header="Продукт" Binding="{Binding ProductName}" Width="180" />
                                <DataGridTextColumn Header="Валюта" Binding="{Binding Currency}" Width="70" />
                                <DataGridTextColumn Header="Остаток" Binding="{Binding Balance, StringFormat={}{0:N2}}" Width="110" />
                                <DataGridTextColumn Header="Доступно" Binding="{Binding AvailableBalance, StringFormat={}{0:N2}}" Width="110" />
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Content="Открыть карточку счёта" Command="{Binding OpenAccountCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="НОВЫЙ СЧЁТ ИЛИ ВКЛАД" Style="{StaticResource SectionCaption}" />
                        <TextBlock Text="Выберите продукт и введите сумму первоначального взноса. Для вклада сумма должна быть не ниже минимальной."
                                   Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                        <ComboBox ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                                  DisplayMemberPath="Label" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Сумма" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBox Width="160" Text="{Binding OpenAmountText, UpdateSourceTrigger=PropertyChanged}" />
                            <Button Content="Открыть договор" Command="{Binding OpenContractCommand}" Margin="8,0,0,0" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
