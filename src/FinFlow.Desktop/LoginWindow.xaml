<Window x:Class="FinFlow.Desktop.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FinFlow — вход в операционный контур"
        Height="560" Width="880" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#0F172A">
            <StackPanel Margin="40" VerticalAlignment="Center">
                <TextBlock Text="FinFlow" FontSize="40" FontWeight="Bold" Foreground="White" />
                <TextBlock Text="Управление вкладами и текущими счетами"
                           FontSize="16" Foreground="#CBD5F5" TextWrapping="Wrap" Margin="0,10,0,26" />
                <TextBlock TextWrapping="Wrap" Foreground="#94A3B8" FontSize="12" LineHeight="19"
                           Text="Операционный контур коммерческого банка: ведение клиентов и счетов, операции по вкладам, контроль исполнителя, закрытие операционного дня, административные функции. Аналитический контур (КУАП, казначейство, риск, ПОД/ФТ) доступен в веб-приложении." />
                <Border Background="#1E293B" CornerRadius="10" Padding="14" Margin="0,24,0,0">
                    <StackPanel>
                        <TextBlock Text="Демонстрационные учётные записи" Foreground="#E2E8F0" FontWeight="SemiBold" FontSize="12" />
                        <TextBlock Text="operator1 · controller1 · accountant1 · admin" Foreground="#94A3B8" FontSize="11" Margin="0,6,0,0"/>
                        <TextBlock Text="Пароль: FinFlow#2026!   Код второго фактора: 123456" Foreground="#94A3B8" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="White">
            <StackPanel Margin="36" VerticalAlignment="Center">
                <TextBlock Text="Вход в систему" FontSize="22" FontWeight="Bold" />
                <TextBlock Text="Используйте учётную запись сотрудника банка" Foreground="{StaticResource MutedBrush}"
                           FontSize="12" Margin="0,6,0,24" />

                <TextBlock Text="Логин" Style="{StaticResource SectionCaption}" />
                <TextBox x:Name="LoginBox" Height="34" Margin="0,0,0,14" />

                <TextBlock Text="Пароль" Style="{StaticResource SectionCaption}" />
                <PasswordBox x:Name="PasswordBox" Height="34" Margin="0,0,0,14" />

                <TextBlock Text="Второй фактор (для контролёра и администратора)" Style="{StaticResource SectionCaption}" />
                <TextBox x:Name="SecondFactorBox" Height="34" Margin="0,0,0,20" />

                <Button x:Name="LoginButton" Content="Войти" Height="38" Click="OnLoginClick" />
                <TextBlock x:Name="StatusText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap"
                           Margin="0,12,0,0" FontSize="12" />

                <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap"
                           Text="Все действия пользователей фиксируются в журнале аудита (только добавление, срок хранения не менее 5 лет)." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
